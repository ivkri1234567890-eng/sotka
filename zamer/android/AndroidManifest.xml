<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ru.zamer.smeta.pro24" android:versionCode="30" android:versionName="3.0">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34"/>
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false"/>
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <queries>
        <intent><action android:name="android.media.action.IMAGE_CAPTURE"/></intent>
        <intent><action android:name="android.intent.action.GET_CONTENT"/><data android:mimeType="image/*"/></intent>
    </queries>
    <application android:theme="@android:style/Theme.Material.Light.NoActionBar" android:label="Замер и смета 3.0"
        android:icon="@mipmap/ic_launcher" android:allowBackup="false" android:fullBackupContent="false"
        android:usesCleartextTraffic="false">
        <activity android:name="ru.zamer.smeta.ActivationActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name="ru.zamer.smeta.SurveyActivity" android:exported="false"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"/>
        <!-- The original activation activity launches this explicit component. -->
        <activity-alias android:name="ru.zamer.smeta.UpdatedActivity"
            android:targetActivity="ru.zamer.smeta.SurveyActivity" android:exported="false"/>
        <activity android:name="ru.zamer.smeta.PhotoPick" android:exported="false" android:theme="@android:style/Theme.Translucent.NoTitleBar"/>
        <provider android:name="ru.zamer.smeta.PhotoProvider" android:authorities="ru.zamer.smeta.pro24.photos" android:exported="false" android:grantUriPermissions="true"/>
        <provider android:name="ru.zamer.smeta.FilesProvider" android:authorities="ru.zamer.smeta.pro24.files" android:exported="false" android:grantUriPermissions="true"/>
        <provider android:name="ru.zamer.smeta.CaptureProvider" android:authorities="ru.zamer.smeta.pro24.capture" android:exported="false" android:grantUriPermissions="true"/>
    </application>
</manifest>
